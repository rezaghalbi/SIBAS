# SIBAS — contoh nama variabel lingkungan.
# File ini hanya dokumentasi; aplikasi TIDAK membaca .env saat runtime.
# Nilai dibaca saat compile lewat --dart-define (lihat lib/main.dart).
# Isi nilai asli hanya di mesin lokal / GitHub Secrets, jangan commit.

# URL project Supabase, contoh format: https://<project-ref>.supabase.co
SUPABASE_URL=

# Anon/public key Supabase. Jangan pernah memakai service_role key di klien.
SUPABASE_ANON_KEY=

# Cara pakai:
# flutter run \
#   --dart-define=SUPABASE_URL=<url> \
#   --dart-define=SUPABASE_ANON_KEY=<anon-key>
